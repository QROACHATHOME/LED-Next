<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon in TrayIcon.cs); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LedNext.App</RootNamespace>
    <AssemblyName>LED-Next</AssemblyName>
    <!-- x64 to load PacDrive64.dll. Use x86 if only PacDrive32.dll is available. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LedNext.Core\LedNext.Core.csproj" />
    <ProjectReference Include="..\LedNext.Hardware\LedNext.Hardware.csproj" />
    <ProjectReference Include="..\LedNext.Data\LedNext.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WPF's names (Application, MessageBox, Button…) unambiguous: no global Windows Forms usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Nodify" Version="7.3.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied next to the exe if you drop the SDK DLL into this folder. -->
    <None Include="native\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
