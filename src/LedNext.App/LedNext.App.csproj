<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ API surface: Windows.Media.SpeechSynthesis for Windows' newer voices (OneCoreSpeech.cs). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon in TrayIcon.cs); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LedNext.App</RootNamespace>
    <AssemblyName>LED-Next</AssemblyName>
    <!-- x64 to load PacDrive64.dll. Use x86 if only PacDrive32.dll is available. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- The exe's icon (Explorer, shortcuts). Drawn by tools/make-icon.py. -->
    <ApplicationIcon>Assets\LedNext.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window's icon (taskbar, title bar, Alt+Tab) and the tray icon. -->
    <Resource Include="Assets\LedNext.ico" />
    <None Remove="Assets\LedNext.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LedNext.Core\LedNext.Core.csproj" />
    <ProjectReference Include="..\LedNext.Hardware\LedNext.Hardware.csproj" />
    <ProjectReference Include="..\LedNext.Data\LedNext.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WPF's names (Application, MessageBox, Button…) unambiguous: no global Windows Forms usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Nodify" Version="7.3.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied next to the exe if you drop the SDK DLL into this folder. -->
    <None Include="native\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The front-end helpers (.NET Framework, so not referenced as assemblies): built first, then copied beside the exe
    on a plain build, as a release lays them out: LedNextCmd.exe, front-ends\PinballX\, front-ends\Playnite\.
    A publish (single file) leaves them out; build\Build-Release.ps1 and tools\install.ps1 add them.
  -->
  <ItemGroup>
    <ProjectReference Include="..\LedNext.Cmd\LedNext.Cmd.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\LedNext.PinballX\LedNext.PinballX.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\LedNext.Playnite\LedNext.Playnite.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="CopyFrontEndHelpers" AfterTargets="Build" Condition="'$(_IsPublishing)' != 'true'">
    <ItemGroup>
      <_Cmd Include="..\LedNext.Cmd\bin\$(Configuration)\net48\LedNextCmd.exe" />
      <_Pbx Include="..\LedNext.PinballX\bin\$(Configuration)\net48\LED-Next PinballX Plugin.dll" />
      <_Playnite Include="..\LedNext.Playnite\bin\$(Configuration)\net462\LedNext.Playnite.dll;..\LedNext.Playnite\bin\$(Configuration)\net462\extension.yaml;..\LedNext.Playnite\bin\$(Configuration)\net462\icon.png" />
    </ItemGroup>
    <Copy SourceFiles="@(_Cmd)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_Pbx)" DestinationFolder="$(OutDir)front-ends\PinballX" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_Playnite)" DestinationFolder="$(OutDir)front-ends\Playnite" SkipUnchangedFiles="true" />
  </Target>

</Project>
