<UserControl x:Class="LedNext.App.Views.FrontEndsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Front ends" FontSize="15" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextDim}" Margin="0,4,0,6"
                       Text="Each front end tells LED-Next what is selected and what is playing. LaunchBox, Playnite and PinballX have LED-Next plugins; ES-DE and RetroBat run small scripts; front ends that support LEDBlinky (HyperSpin, RetroFE / CoinOPS, RocketLauncher…) run LED-Next's LEDBlinky.exe stand-in instead of LEDBlinky. Setup here only adds LED-Next's own files; a front end's own settings are left to you (the steps say which). Close LEDBlinky while LED-Next drives the lights: only one program can drive the boards." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding StandInStatus}" Foreground="{StaticResource AppTextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="760" />
                <Button Content="Open the command log" Command="{Binding OpenCommandLogCommand}" Margin="12,0,0,0"
                        ToolTip="logs\led-next-commands.log: every command the LEDBlinky stand-in, LedNextCmd.exe and the scripts passed on" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource AppSurface}" BorderBrush="{StaticResource AppBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="✓ set up" Foreground="#6FCF97" FontWeight="SemiBold"
                                               Visibility="{Binding IsInstalled, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                </DockPanel>
                                <TextBlock Text="{Binding How}" Foreground="{StaticResource AppTextDim}" Margin="0,2,0,4" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Steps}" TextWrapping="Wrap" Margin="0,0,0,6" />

                                <DockPanel Visibility="{Binding HasCopyText, Converter={StaticResource Visible}}" Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyCommand}" Margin="8,0,0,0" VerticalAlignment="Top" />
                                    <TextBox Text="{Binding CopyText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" />
                                </DockPanel>

                                <DockPanel Visibility="{Binding CanInstall, Converter={StaticResource Visible}}" Margin="0,0,0,4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="Browse…" Command="{Binding BrowseCommand}" />
                                        <Button Content="Install" Command="{Binding InstallCommand}" Margin="6,0,0,0" />
                                        <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                             ToolTip="The front end's folder; empty = where it usually is" />
                                </DockPanel>
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource AppTextDim}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
