<UserControl x:Class="LedNext.App.Views.SpeechView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Speak button labels" FontSize="15" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextDim}" Margin="0,4,0,12"
                       Text="When LaunchBox / BigBox launches a game, its button labels (Games tab) are read aloud and each button blinks while its label is said. Games without labels say nothing." />

            <CheckBox Content="Speak button labels when a game is launched" IsChecked="{Binding Enabled}" Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextDim}" Margin="0,0,0,8"
                       Text="Tip: voices without &quot;Desktop&quot; in their name (Microsoft Mark, David, Zira) are Windows' newer voices and sound clearer than the &quot;Desktop&quot; ones LEDBlinky uses." />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Voice" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" Margin="0,3"
                          ToolTip="Voices without &quot;Desktop&quot; in their name are Windows' newer voices, which sound clearer. The &quot;Desktop&quot; ones are the older voices LEDBlinky uses." />
                <TextBlock Grid.Row="1" Text="Speed" VerticalAlignment="Center" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="-10" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1"
                        Value="{Binding Rate}" Margin="0,6" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Rate}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Grid.Row="2" Text="Volume" VerticalAlignment="Center" />
                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"
                        Value="{Binding Volume}" Margin="0,6" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Volume}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Grid.Row="3" Text="Wait after launch (s)" VerticalAlignment="Center" />
                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="0.5"
                        Value="{Binding DelaySeconds}" Margin="0,6" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DelaySeconds}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>

            <CheckBox Content="Blink each button while its label is said" IsChecked="{Binding BlinkButtons}" Margin="0,3" />
            <CheckBox Content="Stop speaking when a button is pressed or a joystick moved" IsChecked="{Binding StopOnInput}" Margin="0,3" />
            <CheckBox Content="Say the game's name first" IsChecked="{Binding SpeakGameName}" Margin="0,3" />
            <Grid Margin="24,0,0,3" IsEnabled="{Binding SpeakGameName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="146" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Pause after the name (s)" VerticalAlignment="Center"
                           ToolTip="Silence between the game's name and its button labels. 0 = the voice's own short pause." />
                <Slider Grid.Column="1" Minimum="0" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="0.25"
                        Value="{Binding PauseAfterNameSeconds}" Margin="0,6" />
                <TextBlock Grid.Column="2" Text="{Binding PauseAfterNameSeconds}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
            <CheckBox Content="Speak again when the game is paused (MAME)" IsChecked="{Binding SpeakOnPause}" Margin="0,3" />
            <CheckBox Content="Also say Start and Coin" IsChecked="{Binding SpeakStartCoin}" Margin="0,3" />
            <CheckBox Content="Also say joystick and other non-button labels" IsChecked="{Binding SpeakJoysticks}" Margin="0,3,0,12" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Before the labels" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Prefix, UpdateSourceTrigger=LostFocus}" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="Start is said as" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" Margin="0,3" />
                <TextBlock Grid.Row="2" Text="Coin is said as" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CoinText, UpdateSourceTrigger=LostFocus}" Margin="0,3" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                <Button Content="Test with the game shown" Command="{Binding TestCommand}"
                        ToolTip="Select a game in the Games tab first; its labels are said and its buttons blink." />
                <Button Content="Stop" Command="{Binding StopSpeakingCommand}" Margin="8,0,0,0" />
                <Button Content="Copy LEDBlinky's speech settings" Command="{Binding CopyFromLedBlinkyCommand}" Margin="8,0,0,0"
                        ToolTip="Reads settings.ini in the LEDBlinky folder (read only): on/off, voice, speed, volume, game name, Start/Coin, blinking, pause." />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource AppAccent}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
