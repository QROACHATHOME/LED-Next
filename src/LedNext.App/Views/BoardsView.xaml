<UserControl x:Class="LedNext.App.Views.BoardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AppSurface}" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Clear pins" Command="{Binding ClearPinsCommand}" />
                    <TextBlock Text="Live output of every pin. Click a pin to light it at full brightness and see which LED it drives."
                               Foreground="{StaticResource AppTextDim}" VerticalAlignment="Center" Margin="12,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Add a board:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding AddModel}" DisplayMemberPath="DisplayName" Width="140" />
                    <TextBlock Text="ID" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <ComboBox ItemsSource="{Binding AddIds}" SelectedItem="{Binding AddId}" Width="50"
                              ToolTip="Ultimarc boards: the ID set with Ultimarc's configuration tool (PacLED64, NanoLED, PacDrive: 1-4; Ultimate I/O: 1, or 2 with the ID #2 firmware). LED-Wiz / Pinscape: the unit number (1-16; a Pinscape's default is 8). LED strips: any number, to tell them apart." />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding AddModel.IsStrip, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="LEDs" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <TextBox Text="{Binding AddLeds, UpdateSourceTrigger=PropertyChanged}" Width="50" VerticalContentAlignment="Center"
                                 ToolTip="How many LEDs the strip has (up to 600). Three pins each." />
                        <TextBlock Text="Port" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <ComboBox ItemsSource="{Binding Ports}" Text="{Binding AddPort}" IsEditable="True" Width="80"
                                  DropDownOpened="OnPortsDropDownOpened" ToolTip="The controller's serial port (Device Manager, Ports)." />
                        <TextBlock Text="Baud" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding AddBaud}" Width="85"
                                  ToolTip="The same speed as the controller's sketch, or WLED's serial speed (115200 by default)." />
                    </StackPanel>
                    <Button Content="Add" Command="{Binding AddBoardCommand}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding AddNote}" Foreground="{StaticResource AppTextDim}" VerticalAlignment="Center" Margin="12,0" />
                </StackPanel>
                <TextBlock Text="{Binding ShownNote}" Foreground="{StaticResource AppTextDim}" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding BoardStatus}" Foreground="{StaticResource AppAccent}" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Boards}" Margin="16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource AppSurface}" BorderBrush="{StaticResource AppBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,0,0,16"
                                Visibility="{Binding IsShown, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource AppTextDim}" Margin="10,2,0,0" />
                                    <Border CornerRadius="9" Padding="8,1" Margin="12,0,0,0" Background="#33373F">
                                        <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="11" />
                                    </Border>
                                    <Button Content="Remove" Margin="12,0,0,0" Padding="8,0" FontSize="11"
                                            Command="{Binding DataContext.RemoveBoardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove this board from LED-Next (its wired pins are disconnected)." />
                                </StackPanel>
                                <!-- LED strips: port, speed, LED count, and runs of LEDs that follow one control. -->
                                <StackPanel Visibility="{Binding IsStrip, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding StripSummary}" Foreground="{StaticResource AppTextDim}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding DataContext.Ports, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Text="{Binding EditPort}" IsEditable="True" Width="80" DropDownOpened="OnPortsDropDownOpened" />
                                        <TextBlock Text="Baud" VerticalAlignment="Center" Margin="10,0,6,0" />
                                        <ComboBox ItemsSource="{Binding DataContext.BaudRates, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding EditBaud}" Width="85" />
                                        <TextBlock Text="LEDs" VerticalAlignment="Center" Margin="10,0,6,0" />
                                        <TextBox Text="{Binding EditLeds, UpdateSourceTrigger=PropertyChanged}" Width="50" VerticalContentAlignment="Center" />
                                        <Button Content="Apply" Margin="8,0,0,0" Padding="8,0"
                                                Command="{Binding DataContext.ApplyStripCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <TextBlock Text="Runs of LEDs that show one control's colour (lighting around the cabinet, a marquee, a button with several LEDs):"
                                               Foreground="{StaticResource AppTextDim}" Margin="0,10,0,4" />
                                    <ItemsControl ItemsSource="{Binding Segments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" MinWidth="200" />
                                                    <Button Content="Remove" Padding="6,0" FontSize="11"
                                                            Command="{Binding DataContext.RemoveSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="LEDs from" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding SegmentFirst, UpdateSourceTrigger=PropertyChanged}" Width="45" VerticalContentAlignment="Center" />
                                        <TextBlock Text="count" VerticalAlignment="Center" Margin="8,0,6,0" />
                                        <TextBox Text="{Binding SegmentCount, UpdateSourceTrigger=PropertyChanged}" Width="45" VerticalContentAlignment="Center" />
                                        <TextBlock Text="follow" VerticalAlignment="Center" Margin="8,0,6,0" />
                                        <ComboBox ItemsSource="{Binding DataContext.ControlIds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SegmentControl}" Width="130"
                                                  ToolTip="Any panel control. For lighting that isn't a button, add a control of kind Other in the Panel tab (e.g. MARQUEE): games, idle shows and tests then light it like a button." />
                                        <Button Content="Add run" Margin="8,0,0,0" Padding="8,0"
                                                Command="{Binding DataContext.AddSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Pins}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding Columns}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="2" Padding="0" Height="46"
                                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Usage}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="4" Background="#2A2B31" BorderBrush="#3A3C45" BorderThickness="1">
                                                            <Grid>
                                                                <Border CornerRadius="3" Background="{Binding Fill}" />
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Usage}" HorizontalAlignment="Center" FontSize="9"
                                                                               Foreground="#B0B3BC" TextTrimming="CharacterEllipsis" Margin="2,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppAccent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Not detected">
                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource AppWarn}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
