<UserControl x:Class="LedNext.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Library: import, filter, results ===== -->
        <Border Background="{StaticResource AppSurface}" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Import from LEDBlinky…" Command="{Binding ImportCommand}"
                                ToolTip="Reads LEDBlinky's game data (the folder is never changed). Replaces the current library." />
                        <TextBlock Text="Game library" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding LibraryInfo}" TextWrapping="Wrap" Foreground="{StaticResource AppTextDim}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" Foreground="{StaticResource AppAccent}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}"
                              DisplayMemberPath="Display" Margin="0,12,0,0" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Search" Foreground="{StaticResource AppTextDim}" VerticalAlignment="Center" Width="50" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="ROM name or title" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,4">
                        <Button DockPanel.Dock="Right" Content="Platform default" Command="{Binding PreviewPlatformDefaultCommand}"
                                ToolTip="Show what a game with no lighting data of its own gets on this platform" />
                        <CheckBox Content="Only games with lights" IsChecked="{Binding LitOnly}" VerticalAlignment="Center"
                                  ToolTip="Hide games that only get the platform default" />
                    </DockPanel>
                    <TextBlock Text="{Binding ResultInfo}" Foreground="{StaticResource AppTextDim}" Margin="0,0,0,6" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedGame}"
                         Background="{StaticResource AppBackground}" Foreground="{StaticResource AppText}"
                         BorderBrush="{StaticResource AppBorder}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Preview ===== -->
        <Grid Grid.Column="1" Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="4*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding PreviewTitle, TargetNullValue='Pick a game to preview its lights'}" FontSize="20" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PreviewSubtitle}" Foreground="{StaticResource AppTextDim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PreviewFrom}" Foreground="{StaticResource AppAccent}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Panel preview with the game's intended colours (also sent live to the boards) -->
            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,10">
                <Border Width="{Binding PanelWidth}" Height="{Binding PanelHeight}" CornerRadius="24"
                        Background="#26272D" BorderBrush="#3A3C45" BorderThickness="2">
                    <ItemsControl ItemsSource="{Binding PreviewButtons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding Size}" Height="{Binding Size}" ToolTip="{Binding ToolTip}" Background="Transparent">
                                    <Ellipse x:Name="Glow" Margin="-8" Opacity="0.55" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding Fill}" />
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="14" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Rectangle x:Name="Ring" Stroke="#55585F" StrokeThickness="3"
                                               RadiusX="{Binding ShapeRadius}" RadiusY="{Binding ShapeRadius}">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{Binding Fill}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" FontSize="15" Foreground="White">
                                        <TextBlock.Effect>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="0.9" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLit}" Value="False">
                                        <Setter TargetName="Glow" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Trackball">
                                        <Setter TargetName="Ring" Property="StrokeThickness" Value="5" />
                                    </DataTrigger>
                                    <!-- lit in the game but no LEDs wired yet (e.g. Start/Coin on this cabinet) -->
                                    <DataTrigger Binding="{Binding IsWired}" Value="False">
                                        <Setter TargetName="Ring" Property="StrokeDashArray" Value="2 1.5" />
                                        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AppWarn}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Viewbox>

            <!-- Controls table + import report -->
            <TabControl Grid.Row="2">
                <TabItem Header="Controls">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Controls}" Grid.IsSharedSizeScope="True" Margin="6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Swatch" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Control" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Color" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Buttons" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Brush}"
                                                BorderBrush="#55585F" BorderThickness="1" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Control}" FontFamily="Consolas" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding ColorName}" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Label}" Margin="0,0,16,0" />
                                        <TextBlock x:Name="Buttons" Grid.Column="4" Text="{Binding ButtonsText}" FontWeight="SemiBold" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="5" Text="{Binding MapSource}" Foreground="{StaticResource AppTextDim}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOnPanel}" Value="False">
                                            <Setter TargetName="Buttons" Property="Foreground" Value="{StaticResource AppTextDim}" />
                                            <Setter TargetName="Buttons" Property="FontWeight" Value="Normal" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Import report">
                    <ListBox ItemsSource="{Binding ImportReport}" Background="{StaticResource AppBackground}" Foreground="{StaticResource AppText}"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
